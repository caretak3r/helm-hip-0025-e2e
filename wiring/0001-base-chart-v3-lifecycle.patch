+package action
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"sort"
+
+	chart "helm.sh/helm/v4/internal/chart/v3"
+	release "helm.sh/helm/v4/internal/release/v2"
+	v2driver "helm.sh/helm/v4/internal/storage/driver"
+	legacychartutil "helm.sh/helm/v4/pkg/chart/v2/util"
+	"helm.sh/helm/v4/pkg/kube"
+	rcommon "helm.sh/helm/v4/pkg/release/common"
+)
+
+func (r *Rollback) v3ReleaseHistory(name string) ([]*release.Release, bool, error) {
+	if r.cfg.ReleasesV2 == nil {
+		return nil, false, nil
+	}
+	history, err := r.cfg.ReleasesV2.History(name)
+	if err != nil {
+		if errors.Is(err, v2driver.ErrReleaseNotFound) {
+			return nil, false, nil
+		}
+		return nil, false, err
+	}
+
+	rels := make([]*release.Release, 0, len(history))
+	for _, item := range history {
+		rel, ok := item.(*release.Release)
+		if !ok || rel.Chart == nil || rel.Chart.Metadata == nil || rel.Chart.Metadata.APIVersion != chart.APIVersionV3 {
+			continue
+		}
+		rels = append(rels, rel)
+	}
+	if len(rels) == 0 {
+		return nil, false, nil
+	}
+	sort.Slice(rels, func(i, j int) bool { return rels[i].Version < rels[j].Version })
+	return rels, true, nil
+}
+
+func (r *Rollback) runV3(ctx context.Context, rels []*release.Release) error {
+	if err := legacychartutil.ValidateReleaseName(rels[len(rels)-1].Name); err != nil {
+		return fmt.Errorf("prepareRollback: Release name is invalid: %s", rels[len(rels)-1].Name)
+	}
+	if r.Version < 0 {
+		return errInvalidRevision
+	}
+	if v3CheckRollback != nil {
+		if err := v3CheckRollback(r); err != nil {
+			return err
+		}
+	}
+
+	current := rels[len(rels)-1]
+	targetVersion := r.Version
+	if targetVersion == 0 {
+		targetVersion = current.Version - 1
+	}
+	var previous *release.Release
+	for _, rel := range rels {
+		if rel.Version == targetVersion {
+			previous = rel
+			break
+		}
+	}
+	if previous == nil {
+		return fmt.Errorf("release has no %d version", targetVersion)
+	}
+
+	serverSideApply, err := getUpgradeServerSideValue(r.ServerSideApply, previous.ApplyMethod)
+	if err != nil {
+		return err
+	}
+	description := r.Description
+	if description == "" {
+		description = fmt.Sprintf("Rollback to %d", targetVersion)
+	}
+	target := &release.Release{
+		Name:      current.Name,
+		Namespace: current.Namespace,
+		Chart:     previous.Chart,
+		Config:    previous.Config,
+		Info: &release.Info{
+			FirstDeployed:    current.Info.FirstDeployed,
+			LastDeployed:     Timestamper(),
+			Status:           rcommon.StatusPendingRollback,
+			Notes:            previous.Info.Notes,
+			RollbackRevision: targetVersion,
+			Description:      description,
+		},
+		Version:     current.Version + 1,
+		Labels:      previous.Labels,
+		Manifest:    previous.Manifest,
+		Hooks:       previous.Hooks,
+		ApplyMethod: string(determineReleaseSSApplyMethod(serverSideApply)),
+	}
+
+	if isDryRun(r.DryRunStrategy) {
+		return nil
+	}
+	if err := r.cfg.ReleasesV2.Create(target); err != nil {
+		return err
+	}
+	if err := r.performV3Rollback(ctx, rels, current, target, previous, serverSideApply); err != nil {
+		return err
+	}
+	return r.cfg.ReleasesV2.Update(target)
+}
+
+func (r *Rollback) performV3Rollback(ctx context.Context, history []*release.Release, current, target, previous *release.Release, serverSideApply bool) error {
+	currentResources, err := r.cfg.KubeClient.Build(bytes.NewBufferString(current.Manifest), false)
+	if err != nil {
+		return r.failV3Rollback(current, target, nil, fmt.Errorf("unable to build kubernetes objects from current release manifest: %w", err))
+	}
+	targetResources, err := r.cfg.KubeClient.Build(bytes.NewBufferString(target.Manifest), false)
+	if err != nil {
+		return r.failV3Rollback(current, target, nil, fmt.Errorf("unable to build kubernetes objects from target release manifest: %w", err))
+	}
+	apply := v3Apply(v3ApplyAll)
+	if v3PlanRollback != nil {
+		planned, err := v3PlanRollback(r, target, previous)
+		if err != nil {
+			return r.failV3Rollback(current, target, nil, fmt.Errorf("recovering sequencing plan for rollback: %w", err))
+		}
+		if planned != nil {
+			apply = planned
+		}
+	}
+	op := &v3Operation{
+		cfg:                   r.cfg,
+		target:                target,
+		source:                current,
+		current:               currentResources,
+		desired:               targetResources,
+		upgrade:               true,
+		waitStrategy:          r.WaitStrategy,
+		waitOptions:           r.WaitOptions,
+		waitForJobs:           r.WaitForJobs,
+		timeout:               r.Timeout,
+		serverSideApply:       serverSideApply,
+		forceConflicts:        r.ForceConflicts,
+		forceReplace:          r.ForceReplace,
+		csaFieldManagerUpdate: isReleaseApplyMethodClientSideApply(current.ApplyMethod) && serverSideApply,
+	}
+	if !r.DisableHooks {
+		if err := r.cfg.execHookV3(target, release.HookPreRollback, r.WaitStrategy, r.WaitOptions, r.Timeout, serverSideApply); err != nil {
+			return r.failV3Rollback(current, target, nil, fmt.Errorf("pre-rollback hooks failed: %w", err))
+		}
+	}
+	if err := apply(ctx, op); err != nil {
+		return r.failV3Rollback(current, target, op.created, err)
+	}
+	if !r.DisableHooks {
+		if err := r.cfg.execHookV3(target, release.HookPostRollback, r.WaitStrategy, r.WaitOptions, r.Timeout, serverSideApply); err != nil {
+			return r.failV3Rollback(current, target, op.created, fmt.Errorf("post-rollback hooks failed: %w", err))
+		}
+	}
+
+	for _, rel := range history {
+		if rel.Info.Status != rcommon.StatusDeployed {
+			continue
+		}
+		rel.SetStatus(rcommon.StatusSuperseded, "superseded by rollback")
+		if err := r.cfg.ReleasesV2.Update(rel); err != nil {
+			return r.failV3Rollback(current, target, op.created, err)
+		}
+	}
+	target.Info.Status = rcommon.StatusDeployed
+	return nil
+}
+
+func (r *Rollback) failV3Rollback(current, target *release.Release, created kube.ResourceList, rollbackErr error) error {
+	msg := fmt.Sprintf("Rollback %q failed: %s", target.Name, rollbackErr)
+	current.Info.Status = rcommon.StatusSuperseded
+	target.SetStatus(rcommon.StatusFailed, msg)
+	_ = r.cfg.ReleasesV2.Update(current)
+	_ = r.cfg.ReleasesV2.Update(target)
+	if r.CleanupOnFail && len(created) > 0 {
+		if _, errs := r.cfg.KubeClient.Delete(created, "Background"); len(errs) > 0 {
+			return fmt.Errorf("an error occurred while cleaning up resources after rollback failure: %w: %w", rollbackErr, joinErrors(errs, ", "))
+		}
+	}
+	return rollbackErr
+}
