+*/
+
+package action
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+
+	"k8s.io/cli-runtime/pkg/resource"
+
+	chart "helm.sh/helm/v4/internal/chart/v3"
+	chartutil "helm.sh/helm/v4/internal/chart/v3/util"
+	release "helm.sh/helm/v4/internal/release/v2"
+	"helm.sh/helm/v4/pkg/chart/common"
+	commonutil "helm.sh/helm/v4/pkg/chart/common/util"
+	legacychartutil "helm.sh/helm/v4/pkg/chart/v2/util"
+	"helm.sh/helm/v4/pkg/kube"
+	ri "helm.sh/helm/v4/pkg/release"
+	rcommon "helm.sh/helm/v4/pkg/release/common"
+	"helm.sh/helm/v4/pkg/storage/driver"
+)
+
+func (u *Upgrade) runV3WithContext(ctx context.Context, name string, chrt *chart.Chart, vals map[string]any) (*release.Release, error) {
+	if chrt == nil {
+		return nil, errMissingChart
+	}
+	if u.cfg.ReleasesV2 == nil {
+		return nil, errors.New("release/v2 storage is not configured")
+	}
+	if v3CheckUpgrade != nil {
+		if err := v3CheckUpgrade(u); err != nil {
+			return nil, err
+		}
+	}
+	if err := legacychartutil.ValidateReleaseName(name); err != nil {
+		return nil, fmt.Errorf("release name is invalid: %s", name)
+	}
+	if !isDryRun(u.DryRunStrategy) && u.HideSecret {
+		return nil, errors.New("hiding Kubernetes secrets requires a dry-run mode")
+	}
+
+	history, err := u.cfg.ReleasesV2.History(name)
+	if err != nil {
+		if errors.Is(err, driver.ErrReleaseNotFound) {
+			return nil, driver.NewErrNoDeployedReleases(name)
+		}
+		return nil, err
+	}
+	lastRelease, err := latestV3Release(history)
+	if err != nil {
+		return nil, err
+	}
+	if lastRelease == nil {
+		return nil, driver.NewErrNoDeployedReleases(name)
+	}
+	if lastRelease.Info.Status.IsPending() {
+		return nil, errPending
+	}
+	currentRelease, err := latestDeployedV3Release(history)
+	if err != nil {
+		return nil, err
+	}
+	if currentRelease == nil {
+		return nil, driver.NewErrNoDeployedReleases(name)
+	}
+
+	vals, err = u.reuseValuesV3(chrt, currentRelease, vals)
+	if err != nil {
+		return nil, err
+	}
+	if err := chartutil.ProcessDependencies(chrt, vals); err != nil {
+		return nil, err
+	}
+
+	revision := lastRelease.Version + 1
+	caps, err := u.cfg.getCapabilities()
+	if err != nil {
+		return nil, err
+	}
+	valuesToRender, err := commonutil.ToRenderValuesWithSchemaValidation(chrt, vals, releaseOptionsForV3Upgrade(name, currentRelease.Namespace, revision), caps, u.SkipSchemaValidation)
+	if err != nil {
+		return nil, err
+	}
+	if driver.ContainsSystemLabels(u.Labels) {
+		return nil, fmt.Errorf("user supplied labels contains system reserved label name. System labels: %+v", driver.GetSystemLabels())
+	}
+	serverSideApply, err := getUpgradeServerSideValue(u.ServerSideApply, lastRelease.ApplyMethod)
+	if err != nil {
+		return nil, err
+	}
+
+	renderer := &Install{
+		cfg:                u.cfg,
+		DryRunStrategy:     u.DryRunStrategy,
+		HideSecret:         u.HideSecret,
+		SubNotes:           u.SubNotes,
+		EnableDNS:          u.EnableDNS,
+		PostRenderer:       u.PostRenderer,
+		PostRenderStrategy: u.PostRenderStrategy,
+		ReleaseName:        name,
+		Namespace:          currentRelease.Namespace,
+	}
+	hooks, manifest, notes, manifests, err := renderer.renderResourcesV3(ctx, chrt, valuesToRender)
+	if err != nil {
+		return nil, err
+	}
+
+	upgradedRelease := &release.Release{
+		Name:      name,
+		Namespace: currentRelease.Namespace,
+		Chart:     chrt,
+		Config:    vals,
+		Info: &release.Info{
+			FirstDeployed: currentRelease.Info.FirstDeployed,
+			LastDeployed:  Timestamper(),
+			Status:        rcommon.StatusPendingUpgrade,
+			Description:   "Preparing upgrade",
+			Notes:         notes,
+		},
+		Version:     revision,
+		Manifest:    manifest,
+		Hooks:       hooks,
+		Labels:      mergeCustomLabels(lastRelease.Labels, u.Labels),
+		ApplyMethod: string(determineReleaseSSApplyMethod(serverSideApply)),
+	}
+
+	apply := v3Apply(v3ApplyAll)
+	if v3PlanUpgrade != nil {
+		planned, err := v3PlanUpgrade(u, chrt, upgradedRelease, manifests)
+		if err != nil {
+			return upgradedRelease, fmt.Errorf("building sequencing plan: %w", err)
+		}
+		if planned != nil {
+			apply = planned
+		}
+	}
+
+	current, err := u.cfg.KubeClient.Build(bytes.NewBufferString(currentRelease.Manifest), false)
+	if err != nil {
+		return upgradedRelease, fmt.Errorf("unable to build kubernetes objects from current release manifest: %w", err)
+	}
+	target, err := u.cfg.KubeClient.Build(bytes.NewBufferString(upgradedRelease.Manifest), !u.DisableOpenAPIValidation)
+	if err != nil {
+		return upgradedRelease, fmt.Errorf("unable to build kubernetes objects from new release manifest: %w", err)
+	}
+	if err := target.Visit(setMetadataVisitor(upgradedRelease.Name, upgradedRelease.Namespace, true)); err != nil {
+		return upgradedRelease, err
+	}
+	if err := u.adoptNewV3UpgradeResources(current, target, upgradedRelease); err != nil {
+		return nil, err
+	}
+
+	if isDryRun(u.DryRunStrategy) {
+		if u.Description != "" {
+			upgradedRelease.Info.Description = u.Description
+		} else {
+			upgradedRelease.Info.Description = "Dry run complete"
+		}
+		return upgradedRelease, nil
+	}
+	if err := u.cfg.ReleasesV2.Create(upgradedRelease); err != nil {
+		return nil, err
+	}
+
+	op := &v3Operation{
+		cfg:                   u.cfg,
+		target:                upgradedRelease,
+		source:                currentRelease,
+		current:               current,
+		desired:               target,
+		upgrade:               true,
+		waitStrategy:          u.WaitStrategy,
+		waitOptions:           u.WaitOptions,
+		waitForJobs:           u.WaitForJobs,
+		timeout:               u.Timeout,
+		serverSideApply:       serverSideApply,
+		forceConflicts:        u.ForceConflicts,
+		forceReplace:          u.ForceReplace,
+		disableOpenAPI:        u.DisableOpenAPIValidation,
+		threeWayMerge:         u.TakeOwnership && !serverSideApply,
+		csaFieldManagerUpdate: isReleaseApplyMethodClientSideApply(currentRelease.ApplyMethod) && serverSideApply,
+	}
+	failUpgrade := func(err error) (*release.Release, error) {
+		upgradedRelease.SetStatus(rcommon.StatusFailed, fmt.Sprintf("Upgrade %q failed: %s", name, err))
+		_ = u.cfg.ReleasesV2.Update(upgradedRelease)
+		if !u.RollbackOnFailure {
+			return upgradedRelease, err
+		}
+		u.cfg.Logger().Debug("Upgrade failed and rollback-on-failure is set, rolling back to previous successful release")
+		rollin := NewRollback(u.cfg)
+		rollin.Version = currentRelease.Version
+		rollin.WaitStrategy = u.WaitStrategy
+		rollin.WaitOptions = u.WaitOptions
+		rollin.WaitForJobs = u.WaitForJobs
+		rollin.DisableHooks = u.DisableHooks
+		rollin.ForceReplace = u.ForceReplace
+		rollin.ForceConflicts = u.ForceConflicts
+		rollin.ServerSideApply = u.ServerSideApply
+		rollin.Timeout = u.Timeout
+		if rollErr := rollin.RunWithContext(ctx, name); rollErr != nil {
+			return upgradedRelease, fmt.Errorf("an error occurred while rolling back the release. original upgrade error: %w: %w", err, rollErr)
+		}
+		return upgradedRelease, fmt.Errorf("release %s failed, and has been rolled back due to rollback-on-failure being set: %w", name, err)
+	}
+	if !u.DisableHooks {
+		if err := u.cfg.execHookV3(upgradedRelease, release.HookPreUpgrade, u.WaitStrategy, u.WaitOptions, u.Timeout, serverSideApply); err != nil {
+			return failUpgrade(fmt.Errorf("pre-upgrade hooks failed: %w", err))
+		}
+	}
+	if err := apply(ctx, op); err != nil {
+		return failUpgrade(err)
+	}
+	if !u.DisableHooks {
+		if err := u.cfg.execHookV3(upgradedRelease, release.HookPostUpgrade, u.WaitStrategy, u.WaitOptions, u.Timeout, serverSideApply); err != nil {
+			return failUpgrade(fmt.Errorf("post-upgrade hooks failed: %w", err))
+		}
+	}
+
+	currentRelease.SetStatus(rcommon.StatusSuperseded, "superseded by new release")
+	if err := u.cfg.ReleasesV2.Update(currentRelease); err != nil {
+		return upgradedRelease, err
+	}
+	if u.Description != "" {
+		upgradedRelease.SetStatus(rcommon.StatusDeployed, u.Description)
+	} else {
+		upgradedRelease.SetStatus(rcommon.StatusDeployed, "Upgrade complete")
+	}
+	if err := u.cfg.ReleasesV2.Update(upgradedRelease); err != nil {
+		return upgradedRelease, err
+	}
+	return upgradedRelease, nil
+}
+
+func releaseOptionsForV3Upgrade(name, namespace string, revision int) common.ReleaseOptions {
+	return common.ReleaseOptions{Name: name, Namespace: namespace, Revision: revision, IsUpgrade: true}
+}
+
+func latestDeployedV3Release(history []ri.Releaser) (*release.Release, error) {
+	var latest *release.Release
+	for _, item := range history {
+		rel, ok := item.(*release.Release)
+		if !ok {
+			return nil, fmt.Errorf("release/v2 storage returned unsupported release type %T", item)
+		}
+		if rel.Info.Status == rcommon.StatusDeployed && (latest == nil || rel.Version > latest.Version) {
+			latest = rel
+		}
+	}
+	return latest, nil
+}
+
+func (u *Upgrade) reuseValuesV3(chrt *chart.Chart, current *release.Release, newVals map[string]any) (map[string]any, error) {
+	if u.ResetValues {
+		return newVals, nil
+	}
+	if u.ReuseValues {
+		oldVals, err := commonutil.CoalesceValues(current.Chart, current.Config)
+		if err != nil {
+			return nil, fmt.Errorf("failed to rebuild old values: %w", err)
+		}
+		newVals = commonutil.CoalesceTables(newVals, current.Config)
+		chrt.Values = oldVals
+		return newVals, nil
+	}
+	if u.ResetThenReuseValues {
+		return commonutil.CoalesceTables(newVals, current.Config), nil
+	}
+	if len(newVals) == 0 && len(current.Config) > 0 {
+		return current.Config, nil
+	}
+	return newVals, nil
+}
+
+func (u *Upgrade) adoptNewV3UpgradeResources(current, target kube.ResourceList, upgradedRelease *release.Release) error {
+	existingResources := make(map[string]bool, len(current))
+	for _, item := range current {
+		existingResources[objectKey(item)] = true
+	}
+	var toBeCreated kube.ResourceList
+	for _, item := range target {
+		if !existingResources[objectKey(item)] {
+			toBeCreated = append(toBeCreated, item)
+		}
+	}
+	var (
+		toBeUpdated kube.ResourceList
+		err         error
+	)
+	if u.TakeOwnership {
+		toBeUpdated, err = requireAdoption(toBeCreated)
+	} else {
+		toBeUpdated, err = existingResourceConflict(toBeCreated, upgradedRelease.Name, upgradedRelease.Namespace)
+	}
+	if err != nil {
+		return fmt.Errorf("unable to continue with update: %w", err)
+	}
+	return toBeUpdated.Visit(func(item *resource.Info, err error) error {
+		if err != nil {
+			return err
+		}
+		current.Append(item)
+		return nil
+	})
+}
