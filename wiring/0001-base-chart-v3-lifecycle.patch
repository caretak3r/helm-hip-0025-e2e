diff --git a/pkg/action/uninstall_v3.go b/pkg/action/uninstall_v3.go
new file mode 100644
index 000000000..9ad55cb9a
--- /dev/null
+++ b/pkg/action/uninstall_v3.go
@@ -0,0 +1,160 @@
+/*
