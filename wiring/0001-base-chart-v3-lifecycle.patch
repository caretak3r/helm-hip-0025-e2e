+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package action
+
+// HIP-0025 e2e harness wiring (hip0025-wire/base) — never contributed.
+//
+// Upstream main cannot install chart-v3 releases yet, so every e2e tier carries
+// this plain chart-v3 lifecycle. The feature overlays plug into the seams below:
+//
+//	wire_ordered_v3.go   (trees with PR1) sequenced apply and teardown
+//	wire_readiness_v3.go (trees with PR3) custom-readiness waiter options
+//
+// With no overlay, every chart-v3 operation applies everything at once and
+// waits the ordinary way, exactly like chart v2.
+
+import (
+	"context"
+	"time"
+
+	chart "helm.sh/helm/v4/internal/chart/v3"
+	release "helm.sh/helm/v4/internal/release/v2"
+	releaseutil "helm.sh/helm/v4/internal/release/v2/util"
+	"helm.sh/helm/v4/pkg/kube"
+)
+
+// v3Operation is one install, upgrade or rollback of a chart-v3 release.
+type v3Operation struct {
+	cfg     *Configuration
+	target  *release.Release  // revision being deployed
+	source  *release.Release  // revision being replaced; nil on install
+	current kube.ResourceList // objects owned by source (adopted objects on install)
+	desired kube.ResourceList // objects rendered for target
+	upgrade bool
+
+	waitStrategy kube.WaitStrategy
+	waitOptions  []kube.WaitOption
+	waitForJobs  bool
+	timeout      time.Duration
+
+	serverSideApply       bool
+	forceConflicts        bool
+	forceReplace          bool
+	disableOpenAPI        bool
+	threeWayMerge         bool
+	csaFieldManagerUpdate bool
+
+	created kube.ResourceList // set by the apply strategy, for cleanup on failure
+}
+
+// v3Apply deploys an operation. v3ApplyAll is the default.
+type v3Apply func(ctx context.Context, op *v3Operation) error
+
+// v3Delete tears a release down; it returns the "kept by resource policy" text.
+type v3Delete func(u *Uninstall, rel *release.Release, waiter kube.Waiter) (string, error)
+
+// Seams. A nil planner (or a planner returning nil) keeps the plain behaviour.
+var (
+	v3CheckInstall  func(*Install) error
+	v3CheckUpgrade  func(*Upgrade) error
+	v3CheckRollback func(*Rollback) error
+
+	v3PlanInstall   func(i *Install, chrt *chart.Chart, rel *release.Release, manifests []releaseutil.Manifest) (v3Apply, error)
+	v3PlanUpgrade   func(u *Upgrade, chrt *chart.Chart, rel *release.Release, manifests []releaseutil.Manifest) (v3Apply, error)
+	v3PlanRollback  func(r *Rollback, target, previous *release.Release) (v3Apply, error)
+	v3PlanUninstall func(u *Uninstall, rel *release.Release) (v3Delete, error)
+
+	v3WaitOptions = func(_ kube.WaitStrategy, opts []kube.WaitOption, _ kube.ResourceList) ([]kube.WaitOption, error) {
+		return opts, nil
+	}
+)
+
+// v3ApplyAll sends every object at once, then waits for all of them: chart v2
+// semantics. Update also deletes objects the source had and the target lacks.
+func v3ApplyAll(_ context.Context, op *v3Operation) error {
+	var result *kube.Result
+	var err error
+	if !op.upgrade && len(op.current) == 0 {
+		result, err = op.cfg.KubeClient.Create(op.desired, kube.ClientCreateOptionServerSideApply(op.serverSideApply, false))
+	} else {
+		result, err = op.cfg.KubeClient.Update(
+			op.current,
+			op.desired,
+			kube.ClientUpdateOptionForceReplace(op.forceReplace),
+			kube.ClientUpdateOptionServerSideApply(op.serverSideApply, op.forceConflicts),
+			kube.ClientUpdateOptionThreeWayMergeForUnstructured(op.threeWayMerge),
+			kube.ClientUpdateOptionUpgradeClientSideFieldManager(op.csaFieldManagerUpdate),
+		)
+	}
+	if result != nil {
+		op.created = result.Created
+	}
+	if err != nil {
+		return err
+	}
+	return op.wait(op.desired)
+}
+
+// waiter returns the operation's waiter with the tree's extra options applied.
+func (op *v3Operation) waiter(strategy kube.WaitStrategy) (kube.Waiter, error) {
+	opts, err := v3WaitOptions(strategy, op.waitOptions, op.desired)
+	if err != nil {
+		return nil, err
+	}
+	return getWaiterForV3(op.cfg.KubeClient, strategy, opts...)
+}
+
+func (op *v3Operation) wait(resources kube.ResourceList) error {
+	waiter, err := op.waiter(op.waitStrategy)
+	if err != nil {
+		return err
+	}
+	if op.waitForJobs {
+		return waiter.WaitWithJobs(resources, op.timeout)
+	}
+	return waiter.Wait(resources, op.timeout)
+}
+
+func getWaiterForV3(client kube.Interface, strategy kube.WaitStrategy, opts ...kube.WaitOption) (kube.Waiter, error) {
+	if withOptions, ok := client.(kube.InterfaceWaitOptions); ok {
+		return withOptions.GetWaiterWithOptions(strategy, opts...)
+	}
+	return client.GetWaiter(strategy)
+}
