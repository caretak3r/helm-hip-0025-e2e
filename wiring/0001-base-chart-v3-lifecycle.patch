+func (i *Install) runV3WithContext(ctx context.Context, chrt *chart.Chart, vals map[string]any) (*release.Release, error) {
+	if interactWithServer(i.DryRunStrategy) {
+		if err := i.cfg.KubeClient.IsReachable(); err != nil {
+			i.cfg.Logger().Error(fmt.Sprintf("cluster reachability check failed: %v", err))
+			return nil, fmt.Errorf("cluster reachability check failed: %w", err)
+		}
+	}
+
+	if !isDryRun(i.DryRunStrategy) && i.HideSecret {
+		return nil, errors.New("hiding Kubernetes secrets requires a dry-run mode")
+	}
+	if v3CheckInstall != nil {
+		if err := v3CheckInstall(i); err != nil {
+			return nil, err
+		}
+	}
+	if err := i.availableNameV3(); err != nil {
+		return nil, fmt.Errorf("release name check failed: %w", err)
+	}
+	if err := chartutil.ProcessDependencies(chrt, vals); err != nil {
+		return nil, fmt.Errorf("chart dependencies processing failed: %w", err)
+	}
+
+	if crds := chrt.CRDObjects(); interactWithServer(i.DryRunStrategy) && !i.SkipCRDs && len(crds) > 0 {
+		if isDryRun(i.DryRunStrategy) {
+			i.cfg.Logger().Warn("This chart or one of its subcharts contains CRDs. Rendering may fail or contain inaccuracies.")
+		} else if err := i.installCRDsV3(crds); err != nil {
+			return nil, err
+		}
+	}
+
+	if !interactWithServer(i.DryRunStrategy) {
+		i.cfg.Capabilities = common.DefaultCapabilities.Copy()
+		if i.KubeVersion != nil {
+			i.cfg.Capabilities.KubeVersion = *i.KubeVersion
+		}
+		i.cfg.Capabilities.APIVersions = append(i.cfg.Capabilities.APIVersions, i.APIVersions...)
+		i.cfg.KubeClient = &kubefake.PrintingKubeClient{Out: io.Discard}
+
+		mem := v2driver.NewMemory()
+		mem.SetNamespace(i.Namespace)
+		i.cfg.ReleasesV2 = storage.Init(mem)
+	} else if len(i.APIVersions) > 0 {
+		i.cfg.Logger().Debug("API Version list given outside of client only mode, this list will be ignored")
+	}
+
+	if i.WaitStrategy == kube.HookOnlyStrategy && i.RollbackOnFailure {
+		i.WaitStrategy = kube.StatusWatcherStrategy
+	}
+
+	caps, err := i.cfg.getCapabilities()
+	if err != nil {
+		return nil, err
+	}
+	isUpgrade := i.IsUpgrade && isDryRun(i.DryRunStrategy)
+	valuesToRender, err := commonutil.ToRenderValuesWithSchemaValidation(chrt, vals, common.ReleaseOptions{
+		Name:      i.ReleaseName,
+		Namespace: i.Namespace,
+		Revision:  1,
+		IsInstall: !isUpgrade,
+		IsUpgrade: isUpgrade,
+	}, caps, i.SkipSchemaValidation)
+	if err != nil {
+		return nil, err
+	}
+	if driver.ContainsSystemLabels(i.Labels) {
+		return nil, fmt.Errorf("user supplied labels contains system reserved label name. System labels: %+v", driver.GetSystemLabels())
+	}
+
+	rel := i.createReleaseV3(chrt, vals, i.Labels)
+	var sortedManifests []releaseutil.Manifest
+	rel.Hooks, rel.Manifest, rel.Info.Notes, sortedManifests, err = i.renderResourcesV3(ctx, chrt, valuesToRender)
+	if err != nil {
+		rel.SetStatus(rcommon.StatusFailed, "failed to render resource: "+err.Error())
+		return rel, err
+	}
+	rel.SetStatus(rcommon.StatusPendingInstall, "Initial install underway")
+
+	var toBeAdopted kube.ResourceList
+	resources, err := i.cfg.KubeClient.Build(bytes.NewBufferString(rel.Manifest), !i.DisableOpenAPIValidation)
+	if err != nil {
+		return nil, fmt.Errorf("unable to build kubernetes objects from release manifest: %w", err)
+	}
+	if err := resources.Visit(setMetadataVisitor(rel.Name, rel.Namespace, true)); err != nil {
+		return nil, err
+	}
+	if interactWithServer(i.DryRunStrategy) && !isUpgrade && len(resources) > 0 {
+		if i.TakeOwnership {
+			toBeAdopted, err = requireAdoption(resources)
+		} else {
+			toBeAdopted, err = existingResourceConflict(resources, rel.Name, rel.Namespace)
+		}
+		if err != nil {
+			return nil, fmt.Errorf("unable to continue with install: %w", err)
+		}
+	}
+	if isDryRun(i.DryRunStrategy) {
+		rel.Info.Description = "Dry run complete"
+		return rel, nil
+	}
+
+	apply := v3Apply(v3ApplyAll)
+	if v3PlanInstall != nil {
+		planned, err := v3PlanInstall(i, chrt, rel, sortedManifests)
+		if err != nil {
+			rel.SetStatus(rcommon.StatusFailed, "failed to build sequencing plan: "+err.Error())
+			return rel, err
+		}
+		if planned != nil {
+			apply = planned
+		}
+	}
+
+	if i.CreateNamespace {
+		if err := i.createNamespaceV3(); err != nil {
+			return nil, err
+		}
+	}
+	if i.Replace {
+		if err := i.replaceReleaseV3(rel); err != nil {
+			return nil, err
+		}
+	}
+	if i.cfg.ReleasesV2 == nil {
+		return rel, errors.New("release/v2 storage is not configured")
+	}
+	if err := i.cfg.ReleasesV2.Create(rel); err != nil {
+		return rel, err
+	}
+
+	rel, err = i.performInstallV3(ctx, rel, apply, toBeAdopted, resources)
+	if err != nil {
+		return i.failReleaseV3(rel, err)
+	}
+	return rel, nil
+}
+
+func (i *Install) failReleaseV3(rel *release.Release, err error) (*release.Release, error) {
+	rel.SetStatus(rcommon.StatusFailed, fmt.Sprintf("Release %q failed: %s", i.ReleaseName, err.Error()))
+	_ = i.recordReleaseV3(rel)
+	if i.RollbackOnFailure {
+		i.cfg.Logger().Debug("install failed and rollback-on-failure is set, uninstalling release", "release", i.ReleaseName)
+		uninstall := NewUninstall(i.cfg)
+		uninstall.DisableHooks = i.DisableHooks
+		uninstall.KeepHistory = false
+		uninstall.Timeout = i.Timeout
+		uninstall.WaitStrategy = i.WaitStrategy
+		uninstall.WaitOptions = i.WaitOptions
+		if _, uninstallErr := uninstall.Run(i.ReleaseName); uninstallErr != nil {
+			return rel, fmt.Errorf("an error occurred while uninstalling the release. original install error: %w: %w", err, uninstallErr)
+		}
+		return rel, fmt.Errorf("release %s failed, and has been uninstalled due to rollback-on-failure being set: %w", i.ReleaseName, err)
+	}
+	return rel, err
+}
+
+func (i *Install) createReleaseV3(chrt *chart.Chart, rawVals map[string]any, labels map[string]string) *release.Release {
+	ts := i.cfg.Now()
+	return &release.Release{
+		Name:      i.ReleaseName,
+		Namespace: i.Namespace,
+		Chart:     chrt,
+		Config:    rawVals,
+		Info: &release.Info{
+			FirstDeployed: ts,
+			LastDeployed:  ts,
+			Status:        rcommon.StatusUnknown,
+		},
+		Version:     1,
+		Labels:      labels,
+		ApplyMethod: string(determineReleaseSSApplyMethod(i.ServerSideApply)),
+	}
+}
+
+func (i *Install) renderResourcesV3(ctx context.Context, chrt *chart.Chart, values common.Values) ([]*release.Hook, string, string, []releaseutil.Manifest, error) {
+	var files map[string]string
+	var err error
+	if interactWithServer(i.DryRunStrategy) && i.cfg.RESTClientGetter != nil {
+		restConfig, configErr := i.cfg.RESTClientGetter.ToRESTConfig()
+		if configErr != nil {
+			return nil, "", "", nil, configErr
+		}
+		e := engine.New(restConfig)
+		e.EnableDNS = i.EnableDNS
+		e.CustomTemplateFuncs = i.cfg.CustomTemplateFuncs
+		files, err = e.RenderWithContext(ctx, chrt, values)
+	} else {
+		e := engine.Engine{EnableDNS: i.EnableDNS, CustomTemplateFuncs: i.cfg.CustomTemplateFuncs}
+		files, err = e.RenderWithContext(ctx, chrt, values)
+	}
+	if err != nil {
+		return nil, "", "", nil, err
+	}
+
+	var notes strings.Builder
+	for name, content := range files {
+		if strings.HasSuffix(name, notesFileSuffix) {
+			if i.SubNotes || name == path.Join(chrt.Name(), "templates", notesFileSuffix) {
+				if notes.Len() > 0 {
+					notes.WriteString("\n")
+				}
+				notes.WriteString(content)
+			}
+			delete(files, name)
+		}
+	}
+
+	if i.PostRenderer != nil {
+		if i.PostRenderStrategy != PostRenderStrategyCombined && i.PostRenderStrategy != "" {
+			return nil, "", notes.String(), nil, fmt.Errorf("post-render strategy %q is not supported for chart apiVersion v3", i.PostRenderStrategy)
+		}
+		merged, mergeErr := annotateAndMerge(files)
+		if mergeErr != nil {
+			return nil, "", notes.String(), nil, fmt.Errorf("error merging manifests: %w", mergeErr)
+		}
+		postRendered, renderErr := i.PostRenderer.Run(bytes.NewBufferString(merged))
+		if renderErr != nil {
+			return nil, "", notes.String(), nil, fmt.Errorf("error while running post render on files: %w", renderErr)
+		}
+		files, err = splitAndDeannotate(postRendered.String(), "")
+		if err != nil {
+			return nil, "", notes.String(), nil, fmt.Errorf("error while parsing post rendered output: %w", err)
+		}
+	}
+
+	hooks, manifests, err := releaseutil.SortManifests(files, nil, releaseutil.InstallOrder)
+	if err != nil {
+		return hooks, joinRenderedFiles(files), "", manifests, err
+	}
+
+	var manifest bytes.Buffer
+	written := make(map[string]bool)
+	if i.IncludeCRDs {
+		for _, crd := range chrt.CRDObjects() {
+			if i.OutputDir == "" {
+				fmt.Fprintf(&manifest, "---\n# Source: %s\n%s\n", crd.Filename, crd.File.Data)
+			} else if err := writeToFile(i.OutputDir, crd.Filename, string(crd.File.Data), written[crd.Filename]); err != nil {
+				return hooks, manifest.String(), notes.String(), manifests, err
+			} else {
+				written[crd.Filename] = true
+			}
+		}
+	}
+	for _, rendered := range manifests {
+		if i.OutputDir == "" {
+			if i.HideSecret && rendered.Head.Kind == "Secret" && rendered.Head.Version == "v1" {
+				fmt.Fprintf(&manifest, "---\n# Source: %s\n# HIDDEN: The Secret output has been suppressed\n", rendered.Name)
+			} else {
+				fmt.Fprintf(&manifest, "---\n# Source: %s\n%s\n", rendered.Name, rendered.Content)
+			}
+			continue
+		}
+		outputDir := i.OutputDir
+		if i.UseReleaseName {
+			outputDir = filepath.Join(outputDir, i.ReleaseName)
+		}
+		if err := writeToFile(outputDir, rendered.Name, rendered.Content, written[rendered.Name]); err != nil {
+			return hooks, manifest.String(), notes.String(), manifests, err
+		}
+		written[rendered.Name] = true
+	}
+	return hooks, manifest.String(), notes.String(), manifests, nil
+}
+
+func joinRenderedFiles(files map[string]string) string {
+	var rendered bytes.Buffer
+	keys := mapsKeys(files)
+	slices.Sort(keys)
+	for _, name := range keys {
+		if strings.TrimSpace(files[name]) != "" {
+			fmt.Fprintf(&rendered, "---\n# Source: %s\n%s\n", name, files[name])
+		}
+	}
+	return rendered.String()
+}
+
+func mapsKeys[V any](values map[string]V) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	return keys
+}
+
+func (i *Install) performInstallV3(ctx context.Context, rel *release.Release, apply v3Apply, toBeAdopted, resources kube.ResourceList) (*release.Release, error) {
+	if !i.DisableHooks {
+		if err := i.cfg.execHookV3(rel, release.HookPreInstall, i.WaitStrategy, i.WaitOptions, i.Timeout, i.ServerSideApply); err != nil {
+			return rel, fmt.Errorf("failed pre-install: %w", err)
+		}
+	}
+	op := &v3Operation{
+		cfg:                   i.cfg,
+		target:                rel,
+		current:               toBeAdopted,
+		desired:               resources,
+		waitStrategy:          i.WaitStrategy,
+		waitOptions:           i.WaitOptions,
+		waitForJobs:           i.WaitForJobs,
+		timeout:               i.Timeout,
+		serverSideApply:       i.ServerSideApply,
+		forceConflicts:        i.ForceConflicts,
+		forceReplace:          i.ForceReplace,
+		disableOpenAPI:        i.DisableOpenAPIValidation,
+		threeWayMerge:         i.TakeOwnership && !i.ServerSideApply,
+		csaFieldManagerUpdate: true,
+	}
+	if err := apply(ctx, op); err != nil {
+		return rel, err
+	}
+	if !i.DisableHooks {
+		if err := i.cfg.execHookV3(rel, release.HookPostInstall, i.WaitStrategy, i.WaitOptions, i.Timeout, i.ServerSideApply); err != nil {
+			return rel, fmt.Errorf("failed post-install: %w", err)
+		}
+	}
+	if i.Description != "" {
+		rel.SetStatus(rcommon.StatusDeployed, i.Description)
+	} else {
+		rel.SetStatus(rcommon.StatusDeployed, "Install complete")
+	}
+	if err := i.recordReleaseV3(rel); err != nil {
+		i.cfg.Logger().Error("failed to record the release", slog.Any("error", err))
+	}
+	return rel, nil
+}
+
+func (i *Install) availableNameV3() error {
+	if err := legacychartutil.ValidateReleaseName(i.ReleaseName); err != nil {
+		return fmt.Errorf("release name %q: %w", i.ReleaseName, err)
+	}
+	if isDryRun(i.DryRunStrategy) || i.cfg.ReleasesV2 == nil {
+		return nil
+	}
+	history, err := i.cfg.ReleasesV2.History(i.ReleaseName)
+	if err != nil || len(history) == 0 {
+		return nil
+	}
+	latest, err := latestV3Release(history)
+	if err != nil {
+		return err
+	}
+	if i.Replace && (latest.Info.Status == rcommon.StatusUninstalled || latest.Info.Status == rcommon.StatusFailed) {
+		return nil
+	}
+	return errors.New("cannot reuse a name that is still in use")
+}
+
+func latestV3Release(history []ri.Releaser) (*release.Release, error) {
+	var latest *release.Release
+	for _, item := range history {
+		rel, ok := item.(*release.Release)
+		if !ok {
+			return nil, fmt.Errorf("release/v2 storage returned unsupported release type %T", item)
+		}
+		if latest == nil || rel.Version > latest.Version {
+			latest = rel
+		}
+	}
+	return latest, nil
+}
+
+func (i *Install) replaceReleaseV3(rel *release.Release) error {
+	history, err := i.cfg.ReleasesV2.History(rel.Name)
+	if err != nil || len(history) == 0 {
+		return nil
+	}
+	latest, err := latestV3Release(history)
+	if err != nil {
+		return err
+	}
+	rel.Version = latest.Version + 1
+	if latest.Info.Status == rcommon.StatusFailed {
+		return nil
+	}
+	latest.SetStatus(rcommon.StatusSuperseded, "superseded by new release")
+	return i.recordReleaseV3(latest)
+}
+
+func (i *Install) recordReleaseV3(rel *release.Release) error {
+	return i.cfg.ReleasesV2.Update(rel)
+}
+
+func (i *Install) createNamespaceV3() error {
+	ns := &v1.Namespace{
+		TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "Namespace"},
+		ObjectMeta: metav1.ObjectMeta{
+			Name:   i.Namespace,
+			Labels: map[string]string{"name": i.Namespace},
+		},
+	}
+	buf, err := yaml.Marshal(ns)
+	if err != nil {
+		return err
+	}
+	resources, err := i.cfg.KubeClient.Build(bytes.NewBuffer(buf), true)
+	if err != nil {
+		return err
+	}
+	_, err = i.cfg.KubeClient.Create(resources, kube.ClientCreateOptionServerSideApply(i.ServerSideApply, false))
+	if apierrors.IsAlreadyExists(err) {
+		return nil
+	}
+	return err
+}
+
+func (i *Install) installCRDsV3(crds []chart.CRD) error {
+	totalItems := []*resource.Info{}
+	for _, obj := range crds {
+		if obj.File == nil {
+			return fmt.Errorf("failed to install CRD %s: file is empty", obj.Name)
+		}
+		if obj.File.Data == nil {
+			return fmt.Errorf("failed to install CRD %s: file data is empty", obj.Name)
+		}
+		resources, err := i.cfg.KubeClient.Build(bytes.NewBuffer(obj.File.Data), false)
+		if err != nil {
+			return fmt.Errorf("failed to install CRD %s: %w", obj.Name, err)
+		}
+		if len(resources) == 0 {
+			return fmt.Errorf("failed to install CRD %s: resources are empty", obj.Name)
+		}
+		if _, err := i.cfg.KubeClient.Create(resources, kube.ClientCreateOptionServerSideApply(i.ServerSideApply, i.ForceConflicts)); err != nil {
+			if apierrors.IsAlreadyExists(err) {
+				continue
+			}
+			return fmt.Errorf("failed to install CRD %s: %w", obj.Name, err)
+		}
+		totalItems = append(totalItems, resources...)
+	}
+	if len(totalItems) == 0 {
+		return nil
+	}
+
+	var waiter kube.Waiter
+	var err error
+	if client, ok := i.cfg.KubeClient.(kube.InterfaceWaitOptions); ok {
+		waiter, err = client.GetWaiterWithOptions(i.WaitStrategy, i.WaitOptions...)
+	} else {
+		waiter, err = i.cfg.KubeClient.GetWaiter(i.WaitStrategy)
+	}
+	if err != nil {
+		return fmt.Errorf("unable to get waiter: %w", err)
+	}
+	if err := waiter.Wait(totalItems, 60*time.Second); err != nil {
+		return err
+	}
+	if i.cfg.RESTClientGetter == nil || i.cfg.Capabilities == nil {
+		return nil
+	}
+	discoveryClient, err := i.cfg.RESTClientGetter.ToDiscoveryClient()
+	if err != nil {
+		return err
+	}
+	if discoveryClient != nil {
+		discoveryClient.Invalidate()
+		_, _ = discoveryClient.ServerGroups()
+	}
+	restMapper, err := i.cfg.RESTClientGetter.ToRESTMapper()
+	if err != nil {
+		return err
+	}
+	if resettable, ok := restMapper.(meta.ResettableRESTMapper); ok {
+		resettable.Reset()
+	}
+	return nil
+}
