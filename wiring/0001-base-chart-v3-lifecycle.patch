+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package action
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"time"
+
+	chart "helm.sh/helm/v4/internal/chart/v3"
+	release "helm.sh/helm/v4/internal/release/v2"
+	v2driver "helm.sh/helm/v4/internal/storage/driver"
+	"helm.sh/helm/v4/pkg/kube"
+	releasei "helm.sh/helm/v4/pkg/release"
+	"helm.sh/helm/v4/pkg/release/common"
+	rv1 "helm.sh/helm/v4/pkg/release/v1"
+)
+
+func (u *Uninstall) v3ReleaseHistory(name string) ([]*release.Release, bool, error) {
+	if u.cfg.ReleasesV2 == nil {
+		return nil, false, nil
+	}
+
+	history, err := u.cfg.ReleasesV2.History(name)
+	if err != nil {
+		if errors.Is(err, v2driver.ErrReleaseNotFound) {
+			return nil, false, nil
+		}
+		return nil, false, err
+	}
+
+	rels := make([]*release.Release, 0, len(history))
+	for _, item := range history {
+		rel, ok := item.(*release.Release)
+		if !ok || rel.Chart == nil || rel.Chart.Metadata == nil || rel.Chart.Metadata.APIVersion != chart.APIVersionV3 {
+			continue
+		}
+		rels = append(rels, rel)
+	}
+	if len(rels) == 0 {
+		return nil, false, nil
+	}
+	sort.Slice(rels, func(i, j int) bool { return rels[i].Version < rels[j].Version })
+	return rels, true, nil
+}
+
+func (u *Uninstall) runV3(rels []*release.Release, waiter kube.Waiter) (*releasei.UninstallReleaseResponse, error) {
+	rel := rels[len(rels)-1]
+	if rel.Info.Status == common.StatusUninstalled {
+		if !u.KeepHistory {
+			if err := u.purgeV3Releases(rels); err != nil {
+				return nil, fmt.Errorf("uninstall: Failed to purge the release: %w", err)
+			}
+			return &releasei.UninstallReleaseResponse{Release: rel}, nil
+		}
+		return nil, fmt.Errorf("the release named %q is already deleted", rel.Name)
+	}
+
+	if u.WaitStrategy == kube.HookOnlyStrategy {
+		var err error
+		waiter, err = getWaiterForV3(u.cfg.KubeClient, kube.StatusWatcherStrategy, u.WaitOptions...)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	rel.Info.Status = common.StatusUninstalling
+	rel.Info.Deleted = time.Now()
+	rel.Info.Description = "Deletion in progress (or silently failed)"
+	res := &releasei.UninstallReleaseResponse{Release: rel}
+	if err := u.cfg.ReleasesV2.Update(rel); err != nil {
+		u.cfg.Logger().Debug("uninstall: Failed to store updated chart-v3 release", "error", err)
+	}
+
+	if !u.DisableHooks {
+		if err := u.cfg.execHookV3(rel, release.HookPreDelete, u.WaitStrategy, u.WaitOptions, u.Timeout, true); err != nil {
+			return res, err
+		}
+	} else {
+		u.cfg.Logger().Debug("delete hooks disabled", "release", rel.Name)
+	}
+
+	teardown := v3Delete(v3DeleteAll)
+	if v3PlanUninstall != nil {
+		planned, err := v3PlanUninstall(u, rel)
+		if err != nil {
+			return nil, fmt.Errorf("failed to recover release plan: %w", err)
+		}
+		if planned != nil {
+			teardown = planned
+		}
+	}
+	report, err := teardown(u, rel, waiter)
+	if err != nil {
+		return nil, fmt.Errorf("failed to delete release: %s: %w", rel.Name, err)
+	}
+	res.Info = report
+
+	if !u.DisableHooks {
+		if err := u.cfg.execHookV3(rel, release.HookPostDelete, u.WaitStrategy, u.WaitOptions, u.Timeout, true); err != nil {
+			return res, err
+		}
+	}
+
+	rel.Info.Status = common.StatusUninstalled
+	if u.Description != "" {
+		rel.Info.Description = u.Description
+	} else {
+		rel.Info.Description = "Uninstallation complete"
+	}
+
+	if !u.KeepHistory {
+		if err := u.purgeV3Releases(rels); err != nil {
+			return res, fmt.Errorf("uninstall: Failed to purge the release: %w", err)
+		}
+		return res, nil
+	}
+	if err := u.cfg.ReleasesV2.Update(rel); err != nil {
+		u.cfg.Logger().Debug("uninstall: Failed to store updated chart-v3 release", "error", err)
+	}
+	return res, nil
+}
+
+func (u *Uninstall) purgeV3Releases(rels []*release.Release) error {
+	for _, rel := range rels {
+		if _, err := u.cfg.ReleasesV2.Delete(rel.Name, rel.Version); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// v3DeleteAll is the chart-v2 teardown (same manifest sort, keep policy and
+// ownership checks), applied to a chart-v3 release record.
+func v3DeleteAll(u *Uninstall, rel *release.Release, waiter kube.Waiter) (string, error) {
+	shim := &rv1.Release{Name: rel.Name, Namespace: rel.Namespace, Manifest: rel.Manifest}
+	deleted, kept, errs := u.deleteRelease(shim)
+	if len(errs) > 0 {
+		return kept, joinErrors(errs, "; ")
+	}
+	if err := waiter.WaitForDelete(deleted, u.Timeout); err != nil {
+		return kept, err
+	}
+	return kept, nil
+}
