+package action
+
+// HIP-0025 e2e harness wiring (hip0025-wire/readiness) — never contributed.
+// Added only to trees that contain PR3: every chart-v3 wait (plain --wait and,
+// on combined trees, each ordered batch) evaluates the helm.sh/readiness-*
+// annotations of the operation's resources.
+
+import (
+	"fmt"
+	"slices"
+
+	"helm.sh/helm/v4/pkg/kube"
+)
+
+// orderedStrategy is PR1's kube.OrderedWaitStrategy, spelled out so this file
+// also compiles on trees without PR1.
+const orderedStrategy kube.WaitStrategy = "ordered"
+
+func init() {
+	v3WaitOptions = func(strategy kube.WaitStrategy, opts []kube.WaitOption, resources kube.ResourceList) ([]kube.WaitOption, error) {
+		if strategy != kube.StatusWatcherStrategy && strategy != orderedStrategy {
+			return opts, nil
+		}
+		eligible, err := kube.CustomReadinessEligibleResources(resources)
+		if err != nil {
+			return nil, fmt.Errorf("failed to identify resources eligible for custom readiness: %w", err)
+		}
+		return append(slices.Clone(opts), kube.WithCustomReadiness(eligible)), nil
+	}
+}
