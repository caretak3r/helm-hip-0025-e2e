From: Rohit Gudi <50377477+caretak3r@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:03:48 -0500
Subject: [PATCH] build(hip0025-wire): ordered template overlay for trees that
 contain PR2 (harness only)

Signed-off-by: Rohit Gudi <50377477+caretak3r@users.noreply.github.com>
---
 pkg/cmd/template.go          | 16 +++++++++--
 pkg/cmd/template_order_v3.go | 56 ++++++++++++++++++++++++++++++++++++
 2 files changed, 69 insertions(+), 3 deletions(-)
 create mode 100644 pkg/cmd/template_order_v3.go

diff --git a/pkg/cmd/template.go b/pkg/cmd/template.go
index a81a191c0..b25f3a624 100644
--- a/pkg/cmd/template.go
+++ b/pkg/cmd/template.go
@@ -41,6 +41,9 @@ import (
 	releaseutilv1 "helm.sh/helm/v4/pkg/release/v1/util"
 )
 
+// newTemplateReleaseV2Hook allows wiring overlays to customize template rendering.
+var newTemplateReleaseV2Hook func(*releasev2.Release) (*templateRelease, error)
+
 const templateDesc = `
 Render chart templates locally and display the output.
 
@@ -252,9 +255,9 @@ func newTemplateRelease(rel ri.Releaser) (*templateRelease, error) {
 	case *releasev1.Release:
 		return newTemplateReleaseV1(r), nil
 	case releasev2.Release:
-		return newTemplateReleaseV2(&r), nil
+		return newTemplateReleaseV2(&r)
 	case *releasev2.Release:
-		return newTemplateReleaseV2(r), nil
+		return newTemplateReleaseV2(r)
 	case nil:
 		return nil, nil
 	default:
@@ -277,7 +280,14 @@ func newTemplateReleaseV1(rel *releasev1.Release) *templateRelease {
 	return result
 }
 
-func newTemplateReleaseV2(rel *releasev2.Release) *templateRelease {
+func newTemplateReleaseV2(rel *releasev2.Release) (*templateRelease, error) {
+	if newTemplateReleaseV2Hook != nil {
+		return newTemplateReleaseV2Hook(rel)
+	}
+	return newTemplateReleaseV2Base(rel), nil
+}
+
+func newTemplateReleaseV2Base(rel *releasev2.Release) *templateRelease {
 	if rel == nil {
 		return nil
 	}
diff --git a/pkg/cmd/template_order_v3.go b/pkg/cmd/template_order_v3.go
new file mode 100644
index 000000000..54b758acc
--- /dev/null
+++ b/pkg/cmd/template_order_v3.go
@@ -0,0 +1,56 @@
