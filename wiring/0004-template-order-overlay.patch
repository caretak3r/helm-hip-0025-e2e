+package cmd
+
+// HIP-0025 e2e harness wiring (hip0025-wire/template) — never contributed.
+// Added only to trees that contain PR2. For chart-v3 releases in `helm template`
+// stdout, renders resource-group delimiters when the plan has more than one batch.
+
+import (
+	releasev2 "helm.sh/helm/v4/internal/release/v2"
+	"helm.sh/helm/v4/internal/release/v2/sequence"
+)
+
+func init() {
+	newTemplateReleaseV2Hook = newTemplateReleaseV2Ordered
+}
+
+func newTemplateReleaseV2Ordered(rel *releasev2.Release) (*templateRelease, error) {
+	if rel == nil {
+		return nil, nil
+	}
+
+	// For chart v3, try to render with resource-group delimiters
+	if rel.Chart != nil && rel.Chart.Metadata != nil && rel.Chart.Metadata.APIVersion == "v3" {
+		manifests, err := sequence.ParseStoredManifests(rel.Manifest)
+		if err != nil {
+			return nil, err
+		}
+		plan, err := sequence.Build(rel.Chart, manifests)
+		if err != nil {
+			return nil, err
+		}
+		if plan != nil && len(plan.Batches) > 1 {
+			result := newTemplateReleaseV2Base(rel)
+			result.manifest = plan.TemplateManifest()
+			return result, nil
+		}
+	}
+
+	return newTemplateReleaseV2Base(rel), nil
+}
+
